local function GetMultiModelTarget(): BasePart?
	local targetNames = {"Multimoving", "Multiper", "Multiilence", "MultiBound", "MultiGod"}
	for _, name in ipairs(targetNames) do
		local foundObj = workspace:FindFirstChild(name, true)
		if foundObj then
			if foundObj:IsA("BasePart") then
				return foundObj
			elseif foundObj:IsA("Model") then
				local part = foundObj.PrimaryPart or foundObj:FindFirstChildWhichIsA("BasePart", true)
				if part then
					return part
				end
			end
		end
	end
	return nil
end

local function FilterNodesFromNearest(pathfindNodes: { BasePart }, startPos: Vector3): { BasePart }
	if #pathfindNodes == 0 then return pathfindNodes end
	local closestIndex = 1
	local minDistance = math.huge

	for i, node in ipairs(pathfindNodes) do
		if node and node.Parent then
			local dist = (node.Position - startPos).Magnitude
			if dist < minDistance then
				minDistance = dist
				closestIndex = i
			end
		end
	end

	local trimmed = {}
	for i = closestIndex, #pathfindNodes do
		table.insert(trimmed, pathfindNodes[i])
	end
	return trimmed
end

local function GetSortedRooms(): { Model }
	local rooms = CurrentRooms:GetChildren()
	table.sort(rooms, function(a, b)
		local numA = tonumber(a.Name) or 0
		local numB = tonumber(b.Name) or 0
		return numA < numB
	end)
	return rooms
end

local function GetCurrentRoom(latest: boolean): Model?
	if latest then
		local latestRoomNum = GameData and GameData:FindFirstChild("LatestRoom") and GameData.LatestRoom.Value
		if latestRoomNum then
			return CurrentRooms:FindFirstChild(tostring(latestRoomNum))
		end
		local sortedRooms = GetSortedRooms()
		return sortedRooms[#sortedRooms]
	end

	local currentRoomNum = LocalPlayer:GetAttribute("CurrentRoom")
	if currentRoomNum then
		return CurrentRooms:FindFirstChild(tostring(currentRoomNum))
	end
	return nil
end

