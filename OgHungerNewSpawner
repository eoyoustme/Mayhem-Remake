local function DamagePlayer(entity: any)
	if Humanoid.Health <= 0 or IsPlayerProtected() then return end

	local config = entity.Config
	local newHealth = math.clamp(Humanoid.Health - config.Damage.Amount, 0, Humanoid.MaxHealth)

	if config.Jumpscare and config.Jumpscare.Enabled then
		task.spawn(function()
			PlayJumpscare(config.Jumpscare)
		end)
	end

	Humanoid.Health = newHealth

	if newHealth > 0 then
		task.spawn(entity.RunCallback, entity, "OnDamagePlayer", newHealth)
	else
		task.spawn(entity.RunCallback, entity, "OnKillPlayer")

		if #config.Death.Hints > 0 then
			PlayerGui.MainUI.Death:GetPropertyChangedSignal("Visible"):Wait()

			local colour;
			for name, values in next, Storage.DeathTypes do
				if table.find(values, config.Death.Type:lower()) then
					colour = name
				end
			end
			if not colour then
				for _, c in next, PlayerGui.MainUI.Initiator.Main_Game.Health.Music:GetChildren() do
					if c.Name:lower() == config.Death.Type:lower() then
						colour = c.Name
					end
				end
			end
			if not colour then
				colour = "Blue"
			end

			if firesignal then
				firesignal(Remotes.DeathHint.OnClientEvent, config.Death.Hints, colour)
			else
				warn(debug.traceback("function 'firesignal' not supported by exploit, ignoring death hints"))
			end
		end

		local cause = config.Death.Cause
		if typeof(cause) == "string" and cause ~= "" then
			GameStats["Player_".. LocalPlayer.Name].Total.DeathCause.Value = cause
		end
	end
end

local function GetNodesFromRoom(room: Model, reversed: boolean, config: any?): { BasePart }
	local nodes = {}

	local roomEntrance = room:FindFirstChild("RoomEntrance") or room:WaitForChild("RoomEntrance", 2)
	if roomEntrance then
		table.insert(nodes, roomEntrance)
	end

	if not (config and config.Movement and config.Movement.ReboundMoving) then
		local nodesFolder = room:FindFirstChild("PathfindNodes")
		if nodesFolder then
			local folderNodes = nodesFolder:GetChildren()
			table.sort(folderNodes, function(a, b)
				local numA = tonumber(a.Name) or 0
				local numB = tonumber(b.Name) or 0
				return numA < numB
			end)
			for _, n in ipairs(folderNodes) do
				table.insert(nodes, n)
			end
		end
	end

	local roomExit = room:FindFirstChild("RoomExit") or room:WaitForChild("RoomExit", 2)
	if roomExit then
		table.insert(nodes, roomExit)
	end

	if reversed then
		local rev = {}
		for i = #nodes, 1, -1 do
			table.insert(rev, nodes[i])
		end
		nodes = rev
	end

	return nodes
end

local function GetPathfindNodesAmbush(config: any): { BasePart }
	local pathfindNodes = {}
	local rooms = GetSortedRooms()
	local latestRoom = GetCurrentRoom(true)

	if config.Movement.Reversed == false then
		for _, room in ipairs(rooms) do
			local roomNodes = GetNodesFromRoom(room, false, config)

			for _, node in ipairs(roomNodes) do
				pathfindNodes[#pathfindNodes + 1] = node
			end

			if config.Movement.EndWhenEnterLatestRoom and room == latestRoom and #rooms > 1 then
				break
			end
		end
	else
		for i = #rooms, 1, -1 do
			local room = rooms[i]
			local roomNodes = GetNodesFromRoom(room, true, config)

			for _, node in ipairs(roomNodes) do
				pathfindNodes[#pathfindNodes + 1] = node
			end

			if config.Movement.EndWhenEnterLatestRoom and room == latestRoom and #rooms > 1 then
				break
			end
		end
	end
	return pathfindNodes
end

local function GetPathfindNodesBlitz(config: any): ({BasePart}, {BasePart})
	local nodesToCurrent, nodesToEnd = {}, {}
	local currentRoomIndex = LocalPlayer:GetAttribute("CurrentRoom") or 0
	local rooms = GetSortedRooms()
	local latestRoom = GetCurrentRoom(true)

	if config.Movement.Reversed == false then
		for _, room in ipairs(rooms) do
			local roomNodes = GetNodesFromRoom(room, false, config)
			local roomIndex = tonumber(room.Name) or 0

			for _, node in ipairs(roomNodes) do
				if roomIndex <= currentRoomIndex then
					nodesToCurrent[#nodesToCurrent + 1] = node
				else
					nodesToEnd[#nodesToEnd + 1] = node
				end
			end

			if config.Movement.EndWhenEnterLatestRoom and room == latestRoom and #rooms > 1 then
				break
			end
		end
	else
		for i = #rooms, 1, -1 do
			local room = rooms[i]
			local roomNodes = GetNodesFromRoom(room, true, config)
			local roomIndex = tonumber(room.Name) or 0

			for _, node in ipairs(roomNodes) do
				if roomIndex >= currentRoomIndex then
					nodesToCurrent[#nodesToCurrent + 1] = node
				else
					nodesToEnd[#nodesToEnd + 1] = node
				end
			end

			if config.Movement.EndWhenEnterLatestRoom and room == latestRoom and #rooms > 1 then
				break
			end
		end 
	end

	return nodesToCurrent, nodesToEnd
end

local function GetCurrentSpeed(model: Model, config: any): number
	if config.Movement and config.Movement.MoveFastNotEnter then
		local latestRoom = GetCurrentRoom(true)
		if latestRoom then
			local latestNum = tonumber(latestRoom.Name) or 0
			local currentNum = model:GetAttribute("LastEnteredRoom") or -1
			if currentNum < latestNum then
				return config.Movement.SpeedFast or (CONST.BASE_ENTITY_SPEED / 100 * 370)
			end
		end
	end
	return config.Movement.Speed or CONST.BASE_ENTITY_SPEED
end

local function EntityMoveToSpeed(model: Model, cframe: CFrame, speedInput: any)
	if not model or not model.Parent then return end
	local reached = false
	local connection
	connection = RunService.Stepped:Connect(function(_, step)
		if not model or not model.Parent then
			if connection then connection:Disconnect() end
			reached = true
			return
		end

		if model:GetAttribute("IsChasing") then
			if connection then connection:Disconnect() end
			reached = true
			return
		end

		if not model:GetAttribute("Paused") then
			local speed = typeof(speedInput) == "function" and speedInput() or speedInput or CONST.BASE_ENTITY_SPEED
			local pivot = model:GetPivot()
			local difference = (cframe.Position - pivot.Position)
			local magnitude = difference.Magnitude

			if magnitude > 0.05 then
				local unit = difference.Unit
				model:PivotTo(pivot + unit * math.min(step * speed, magnitude))
			else
				connection:Disconnect()
				reached = true
			end
		end
	end)
	repeat RunService.Stepped:Wait() until reached or not model or not model.Parent or model:GetAttribute("IsChasing")
end

local function EntityMoveToTween(model: Model, targetCFrame: CFrame, duration: number)
	if not model or not model.Parent then return end
	local startPivot = model:GetPivot()
	local elapsed = 0
	local connection
	local reached = false

	connection = RunService.Stepped:Connect(function(_, step)
		if not model or not model.Parent then
			if connection then connection:Disconnect() end
			reached = true
			return
		end

		if model:GetAttribute("IsChasing") then
			if connection then connection:Disconnect() end
			reached = true
			return
		end

		-- Không kiểm tra Paused ở đây để Fakeout Tween hoạt động bình thường
		elapsed = elapsed + step
		local alpha = math.clamp(elapsed / math.max(duration, 0.01), 0, 1)
		local quadAlpha = TweenService:GetValue(alpha, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		model:PivotTo(startPivot:Lerp(targetCFrame, quadAlpha))

		if alpha >= 1 then
			connection:Disconnect()
			reached = true
		end
	end)

	repeat RunService.Stepped:Wait() until reached or not model or not model.Parent or model:GetAttribute("IsChasing")
end

local function EntityMoveTo(model: Model, cframe: CFrame, config: any)
	if config.Movement and config.Movement.ReboundMoving then
		EntityMoveToTween(model, cframe, config.Movement.TweenSecond or 1)
	else
		EntityMoveToSpeed(model, cframe, function()
			return GetCurrentSpeed(model, config)
		end)
	end
end

