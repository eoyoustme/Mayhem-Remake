Module.Create = function(self, config: any): any?
	local newConfig = ApplyConfigDefaults(config, CONST.DEFAULT.CONFIG)
	
	-- Tránh nhân trùng tốc độ khi tạo Clone cho ReboundMoveStyle
	if not config._speedProcessed then
		newConfig.Movement.Speed = CONST.BASE_ENTITY_SPEED / 100 * config.Movement.Speed
		if config.Movement and config.Movement.SpeedFast then
			newConfig.Movement.SpeedFast = CONST.BASE_ENTITY_SPEED / 100 * config.Movement.SpeedFast
		end
		newConfig._speedProcessed = true
	end

	local asset = newConfig.Entity.Asset
	local success, entityModel = false, nil

	if typeof(asset) == "Instance" then
		success, entityModel = true, asset
	elseif typeof(asset) == "string" then
		success, entityModel = pcall(function()
			local instance: Instance? = LoadCustomInstance(asset)
			if typeof(instance) == "Instance" then
				if instance.ClassName ~= "Model" then
					error(string.format(
						debug.traceback("Entity model Instance invalid, expected Model but got '%s'"),
						instance.ClassName
						))
					return
				end
			else
				error(debug.traceback("Failed to fetch entity model."))
				return
			end
			return instance
		end)
	end
	if not (success and entityModel) then return end

	local rootPart = entityModel.PrimaryPart or entityModel:FindFirstChildWhichIsA("BasePart", true)
	if not rootPart then return end

	rootPart.Anchored = true
	entityModel.PrimaryPart = rootPart

	local name = config.Entity.Name
	if typeof(name) == "string" and name ~= "" then
		entityModel.Name = name
	end

	for attr, val in next, CONST.ATTR.ENTITY do
		entityModel:SetAttribute(attr, val)
	end

	local c = Instance.new("Configuration")
	c.Name = "RoomsEntered"
	c.Parent = entityModel

	return {
		Model = entityModel,
		Config = newConfig,
		Debug = CloneTable(CONST.DEFAULT.DEBUG),
		SetCallback = function(self, key: string, callback: any)
			assert(typeof(key) == "string", debug.traceback("Callback key must be a string."))
			assert(typeof(callback) == "function", debug.traceback("Callback must be a function."))
			self.Debug[key] = callback
		end,
		RunCallback = function(self, key: string, ...: any?)
			local callback = self.Debug[key]
			if typeof(callback) == "function" then
				local success, result = pcall(callback, ...)
				if not success then
					error(debug.traceback(
						string.format(
							"Error in callback: '%s' for entity: '%s':\n%s",
							key,
							self.Config.Entity.Name,
							result
						)
						))
				end
			end
		end,
		IsAlive = function(self): boolean
			return self.Model and self.Model.Parent
		end,
		Pause = function(self)
			if self:IsAlive() then
				self.Model:SetAttribute("Paused", true)
			end
		end,
		Resume = function(self)
			if self:IsAlive() then
				self.Model:SetAttribute("Paused", false)
			end
		end,
		Run = function(self, copyEntity: boolean)
			Module:Run(self, copyEntity)
		end,
		Despawn = function(self)
			if self:IsAlive() then
				self.Model:Destroy()
				local i = table.find(Module.ActiveEntities, self)
				if i then
					table.remove(Module.ActiveEntities, i)
				end
				task.spawn(self.RunCallback, self, "OnDespawned")
			end
		end
	}
end

Module.Run = function(self, entity: any, copyEntity: boolean, isReboundRespawn: boolean?)
	if copyEntity == true then
		self:Run(CloneTable(entity), false, isReboundRespawn)
		return
	end

	if entity.Model:GetAttribute("Running") then return end
	do
		local rebounding = entity.Config.Rebounding
		if
			rebounding.Enabled
			and (
				rebounding.Min <= 0
					or rebounding.Max <= 0
					or rebounding.Min > rebounding.Max
			)
		then
			error(string.format(
				debug.traceback("Invalid rebounding minmax values: %s - %s"),
				rebounding.Min,
				rebounding.Max
				))
		end
	end

	local model = entity.Model
	local config = entity.Config
	local debug = entity.Debug

	local isFakeout = false
	local fakeoutConfig = config.Movement and config.Movement.Fakeout
	if fakeoutConfig and fakeoutConfig.Enabled and not model:GetAttribute("FakeoutFinished") then
		if fakeoutConfig.RandomFakeout then
			if typeof(fakeoutConfig.RandomFakeout) == "number" then
				isFakeout = (math.random(1, 100) <= fakeoutConfig.RandomFakeout)
			else
				isFakeout = (math.random(1, 2) == 1)
			end
		else
			isFakeout = true
		end
	end

	if isFakeout then
		model:SetAttribute("IsFakeout", true)
		model:SetAttribute("Damage", false)
		task.spawn(entity.RunCallback, entity, "OnFakeoutStart")
	end

	model:SetAttribute("Running", true)
	self.ActiveEntities[#self.ActiveEntities + 1] = entity

	if config.Movement.ReboundMoveStyle and not isReboundRespawn and not model:GetAttribute("ReboundStyleStarted") then
		model:SetAttribute("ReboundStyleStarted", true)

		task.spawn(function()
			local times = math.clamp(tonumber(config.Movement.ReboundStyleTimes) or 1, 1, 7)
			local soundId = config.Movement.ReboundStyleSound
			local volume = config.Movement.ReboundStyleVolume or 1
			local spawnedCount = 0

			local connection
			connection = CurrentRooms.ChildAdded:Connect(function(newRoom)
				if spawnedCount >= times then
					if connection then connection:Disconnect() end
					return
				end

				spawnedCount = spawnedCount + 1

				if soundId and soundId ~= "" and soundId ~= "rbxassetid://" and soundId ~= "rbxassetid://0" then
					local sound = Instance.new("Sound")
					sound.SoundId = soundId
					sound.Volume = volume
					sound.Parent = workspace
					sound:Play()
					Debris:AddItem(sound, 5)
				end

				task.delay(0.2, function()
					local newEntity = Module:Create(config)
					if newEntity then
						newEntity.Debug = CloneTable(entity.Debug)
						task.spawn(entity.RunCallback, entity, "OnReboundStyle", newEntity)
						Module:Run(newEntity, false, true)
					end
				end)
			end)
		end)
	end

	local spawnCFrame: CFrame? = nil

	if config.Movement and config.Movement.IsMoveWhenWHere then
		local multiTarget = GetMultiModelTarget()
		if multiTarget then
			spawnCFrame = multiTarget.CFrame
		end
	end

	if not spawnCFrame then
		local spawnPoint: BasePart? = nil
		local rooms = GetSortedRooms()
		local latestRoom = GetCurrentRoom(true)
		if config.Movement.Reversed then
			local targetRoom = rooms[#rooms]
			if config.Movement.EndWhenEnterLatestRoom and targetRoom == latestRoom and #rooms > 1 then
				targetRoom = rooms[#rooms - 1]
			end
			spawnPoint = targetRoom:FindFirstChild("RoomExit") or targetRoom:FindFirstChild("RoomEntrance")
		else
			spawnPoint = rooms[1]:FindFirstChild("RoomEntrance")
		end

		if not spawnPoint then
			error(string.format(debug.traceback("Failed to find spawn point for entity: '%s'"), config.Entity.Name))
		end
		spawnCFrame = spawnPoint.CFrame
	end

	model:PivotTo(spawnCFrame + Vector3.new(0, config.Entity.HeightOffset, 0))
	model.Parent = workspace
	task.spawn(entity.RunCallback, entity, "OnSpawned")

	if not isReboundRespawn and config.Spawned and config.Spawned.ChangeColorWhenSpawn then
		task.spawn(function()
			local colorCorrection = Lighting:FindFirstChild("MainColorCorrection")
			if not colorCorrection then
				colorCorrection = Instance.new("ColorCorrectionEffect")
				colorCorrection.Name = "MainColorCorrection"
				colorCorrection.Parent = Lighting
			end

			if config.Spawned.Rainbow then
				colorCorrection.TintColor = Color3.fromRGB(255, 255, 255)
				colorCorrection.Contrast = 0.1

				TweenService:Create(colorCorrection, TweenInfo.new(2.5), {Contrast = 0}):Play()

				local redTween = TweenService:Create(colorCorrection, TweenInfo.new(5), {TintColor = Color3.fromRGB(250, 0, 0)})
				redTween:Play()

				task.wait(0.5)

				local colors = {
					Color3.fromRGB(255, 255, 0),  
					Color3.fromRGB(0, 0, 255),    
					Color3.fromRGB(0, 255, 0),   
					Color3.fromRGB(255, 105, 180)  
				}

				for _ = 1, 2 do
					for _, color in ipairs(colors) do
						local tween = TweenService:Create(colorCorrection, TweenInfo.new(0.35), {TintColor = color})
						tween:Play()
						task.wait(0.25)
					end
				end  

				local finalRed = TweenService:Create(colorCorrection, TweenInfo.new(1), {TintColor = Color3.fromRGB(255, 255, 255)})
				finalRed:Play()
			else
				colorCorrection.TintColor = config.Spawned.Color
				colorCorrection.Contrast = 1
				TweenService:Create(colorCorrection, TweenInfo.new(0.5), {Contrast = 0}):Play()
				local TW = TweenService:Create(colorCorrection, TweenInfo.new(5), {TintColor = Color3.fromRGB(255, 255, 255)})
				TW:Play()
			end
		end)
	end

	local currentRoom = GetCurrentRoom(false)
	if not isReboundRespawn and currentRoom then
		if config.Lights.Flicker.Enabled then
			Modules.Module_Events.flicker(currentRoom, config.Lights.Flicker.Duration)
		end

		if config.Earthquake.Enabled then
			task.spawn(Earthquake)
		end
	end

	local startDelay = config.Movement.Delay
	if config.Movement.ReboundMoveStyle and (isReboundRespawn or model:GetAttribute("ReboundStyleStarted")) then
		startDelay = config.Movement.ReboundStyleDelay or config.Movement.Delay
	end
	task.wait(startDelay)

	task.spawn(entity.RunCallback, entity, "OnStartMoving")
	task.spawn(function()
		local lastShakeTick = 0

		while
			entity:IsAlive()
			and task.wait()
		do
			if model:GetAttribute("Paused") then continue end

			local origin = model:GetPivot().Position
			local char = LocalPlayer.Character
			local root = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))
			if not root then continue end
			local charOrigin = root.Position

			local inSight = false
			if (charOrigin - origin).Magnitude <= config.Damage.Range then
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = {Character, model, CollectionService:GetTagged("HidingSpot")}

				inSight = workspace:Raycast(origin, charOrigin - origin, params) == nil
			end

			if config.Movement and config.Movement.ChasePlayerWhenSee and not model:GetAttribute("IsChasing") then
				local basepart = model:FindFirstChildWhichIsA("BasePart", true)
				if basepart then
					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Exclude
					params.FilterDescendantsInstances = {model}

					local direction = charOrigin - basepart.Position
					local rayResult = workspace:Raycast(basepart.Position, direction, params)

					if rayResult and rayResult.Instance:IsDescendantOf(Character) then
						model:SetAttribute("IsChasing", true)
						task.spawn(entity.RunCallback, entity, "PlayerGetSee")

						local Cayracto = Character
						local deergod = model
						local chaseSpeed = config.Movement.SpeedWhenChase or 7.5

						local connection
						local function followPlayer(dt)
							if not Cayracto or not basepart or not deergod then return end

							local hrp = Cayracto:FindFirstChild("HumanoidRootPart") or Cayracto.PrimaryPart
							if not hrp then return end

							local currentPos = basepart.Position
							local targetPos = hrp.Position
							local distance = (targetPos - currentPos).Magnitude

							if distance > 0.5 then
								local dir = (targetPos - currentPos).Unit
								local newPos = currentPos + (dir * chaseSpeed * dt)
								local lookTarget = Vector3.new(targetPos.X, newPos.Y, targetPos.Z)

								if (lookTarget - newPos).Magnitude > 0.001 then
									deergod:PivotTo(CFrame.lookAt(newPos, lookTarget))
								else
									deergod:PivotTo(CFrame.new(newPos))
								end
							end
						end

						connection = RunService.RenderStepped:Connect(function(dt)
							if not basepart or not basepart.Parent or not deergod or not deergod.Parent then
								if connection then
									connection:Disconnect()
									connection = nil
								end
								return
							end
							followPlayer(dt)
						end)
					end
				end
			end

			if Humanoid.Health > 0 then
				local camera = workspace.CurrentCamera
				if camera then
					local _, isVisible = camera:WorldToViewportPoint(origin)
					if isVisible then
						task.spawn(entity.RunCallback, entity, "OnLookAt", inSight)
					end
				end
			end

			do
				local room = GetRoomAtPoint(origin)
				if room then
					local index = tonumber(room.Name)
					local prevRoomIndex = model:GetAttribute("LastEnteredRoom") or -1

					if
						index
						and index >= 0
						and index ~= prevRoomIndex
					then
						model:SetAttribute("LastEnteredRoom", index)

						if config.Movement and config.Movement.FasterAndFaster then
							local mult = typeof(config.Movement.FasterAndFaster) == "number" and config.Movement.FasterAndFaster or 1.3
							config.Movement.Speed = config.Movement.Speed * mult
							if config.Movement.SpeedFast then
								config.Movement.SpeedFast = config.Movement.SpeedFast * mult
							end
						end

						local roomsEntered = model:FindFirstChild("RoomsEntered") :: Folder
						if roomsEntered then
							local firstTime = roomsEntered:GetAttribute(room.Name) == nil

							task.spawn(entity.RunCallback, entity, "OnEnterRoom", room, firstTime)

							if firstTime then
								roomsEntered:SetAttribute(room.Name, true)
							end

							if config.Movement and config.Movement.MoveFastNotEnter then
								local latestRoom = GetCurrentRoom(true)
								local latestNum = latestRoom and tonumber(latestRoom.Name) or 0

								if index < latestNum then
									task.spawn(entity.RunCallback, entity, "OnNotReachedLatestRoom", room, latestRoom)
								elseif index == latestNum then
									task.spawn(entity.RunCallback, entity, "OnReachedLatestRoom", room)
								elseif prevRoomIndex == latestNum and index > latestNum then
									task.spawn(entity.RunCallback, entity, "OnLeftLatestRoom", room)
								end
							end

							local latestRoom = GetCurrentRoom(true)
							if room ~= latestRoom then
								if config.Lights.Shatter then
									Modules.Module_Events.shatter(room)
								elseif config.Lights.Repair then
									FixRoomLights(room)
								end
							end
						end
					end
				end
			end

			local usedCrucifix = false
			do
				local crucifixion = config.Crucifixion
				if
					crucifixion.Enabled
					and crucifixion.Range > 0
					and (charOrigin - origin).Magnitude <= crucifixion.Range
					and inSight
				then
					local hasTool, tool = PlayerHasItemEquipped("Crucifix")
					if hasTool and tool and not model:GetAttribute("BeingBanished") then
						if typeof(debug.CrucifixionOverwrite) == "function" then
							entity:RunCallback("CrucifixionOverwrite")
						else
							tool:Destroy()
							model:SetAttribute("Paused", true)
							CrucifixEntity(entity)
						end
						usedCrucifix = true
					end
				end
			end

			if
				not model:GetAttribute("Paused")
				and not usedCrucifix
				and not isFakeout
			then
				local damage = config.Damage
				local ripper = damage.JumpscareRipper

				if
					damage.Enabled == true
					and damage.Range > 0
					and Humanoid.Health > 0
					and (not Character:GetAttribute("Hiding") or damage.IgnoreHiding)
					and model:GetAttribute("Damage")
					and not model:GetAttribute("BeingBanished")
					and (charOrigin - origin).Magnitude <= damage.Range
					and inSight
				then
					local isMoving = (Humanoid.MoveDirection.Magnitude > 0) or ((RootPart.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 0.5)
					local shouldDamage = true

					if damage.KillOnMove then
						if not isMoving then
							shouldDamage = false
						end
					end

					if shouldDamage then
						model:SetAttribute("Damage", false)

						if ripper and ripper.Enabled == true then
							PlayRipperJumpscare(entity)
						else
							DamagePlayer(entity)

							local cd = damage.Cooldown or 1
							task.delay(cd, function()
								if model and model.Parent and not model:GetAttribute("IsFakeout") then
									model:SetAttribute("Damage", true)
								end
							end)
						end
					end
				end
			end

			-- Sửa lỗi CameraShake chạy ổn định trên cả Clone và ReboundMoveStyle
			do
				local camShake = config.CameraShake
				if camShake and camShake.Enabled then
					local mag = (charOrigin - origin).Magnitude
					local range = camShake.Range or 100
					if mag <= range and range > 0 then
						local now = tick()
						if now - lastShakeTick >= (camShake.Values[3] or 0.1) then
							lastShakeTick = now

							local scale = math.clamp((range - mag) / range, 0, 1)
							local val1 = (camShake.Values[1] or 1.5) * scale
							local val2 = (camShake.Values[2] or 20) * scale
							local val3 = camShake.Values[3] or 0.1
							local val4 = camShake.Values[4] or 1

							pcall(function()
								local shaker = Modules.Main_Game and Modules.Main_Game.camShaker
								if not shaker then
									local camShakerMod = ReplicatedStorage:FindFirstChild("CameraShaker", true)
									if camShakerMod then
										local CameraShaker = require(camShakerMod)
										shaker = CameraShaker.new(Enum.RenderPriority.Camera.Value, function(shakeCf)
											local curCam = workspace.CurrentCamera
											if curCam then curCam.CFrame = curCam.CFrame * shakeCf end
										end)
										shaker:Start()
										if Modules.Main_Game then
											Modules.Main_Game.camShaker = shaker
										end
									end
								end
								if shaker then
									shaker:ShakeOnce(val1, val2, val3, val4)
								end
							end)
						end
					end
				end
			end
		end
	end)

	task.spawn(function()
		local reboundType = config.Rebounding.Type:upper()
		if reboundType == "AMBUSH" then
			local pathfindNodes = GetPathfindNodesAmbush(config)

			if config.Movement and config.Movement.IsMoveWhenWHere then
				local multiTarget = GetMultiModelTarget()
				if multiTarget then
					model:PivotTo(multiTarget.CFrame + Vector3.new(0, config.Entity.HeightOffset, 0))
					pathfindNodes = FilterNodesFromNearest(pathfindNodes, multiTarget.Position)
				else
					pathfindNodes = FilterNodesFromNearest(pathfindNodes, model:GetPivot().Position)
				end
			end

			local roomAddedConn
			roomAddedConn = CurrentRooms.ChildAdded:Connect(function(newRoom)
				if config.Movement and config.Movement.Reversed then return end

				task.spawn(function()
					newRoom:WaitForChild("RoomEntrance", 2)
					local newNodes = GetNodesFromRoom(newRoom, config.Movement.Reversed, config)

					for _, node in ipairs(newNodes) do
						if not table.find(pathfindNodes, node) then
							table.insert(pathfindNodes, node)
						end
					end
				end)
			end)

			local nodeIndex = 1
			while nodeIndex <= #pathfindNodes and entity:IsAlive() do
				if model:GetAttribute("IsChasing") then
					repeat task.wait(0.1) until not entity:IsAlive() or not model:GetAttribute("IsChasing")
					break
				end
				local v = pathfindNodes[nodeIndex]
				if v and v.Parent then
					local cframe = v.CFrame + Vector3.new(0, 3 + config.Entity.HeightOffset, 0)
					EntityMoveTo(model, cframe, config)
					task.spawn(entity.RunCallback, entity, "OnReachNode", v)
				end
				nodeIndex = nodeIndex + 1
			end

			if config.Rebounding.Enabled and not model:GetAttribute("IsChasing") then
				local reboundsCount = math.random(config.Rebounding.Min, config.Rebounding.Max)
				for i = 1, reboundsCount do
					if model:GetAttribute("IsChasing") then break end
					task.wait(config.Rebounding.Delay)
					model:SetAttribute("Damage", true)
					task.spawn(entity.RunCallback, entity, "OnRebounding", true)

					for j = #pathfindNodes, 1, -1 do
						if model:GetAttribute("IsChasing") then break end
						local v = pathfindNodes[j]
						if v and v.Parent then
							local cframe = v.CFrame + Vector3.new(0, 3 + config.Entity.HeightOffset, 0)
							EntityMoveTo(model, cframe, config)
							task.spawn(entity.RunCallback, entity, "OnReachNode", v)
						end
					end

					if model:GetAttribute("IsChasing") then break end

					task.spawn(entity.RunCallback, entity, "OnRebounding", false)
					task.wait(config.Rebounding.Delay)
					model:SetAttribute("Damage", true)
					task.spawn(entity.RunCallback, entity, "OnRebounding", true)

					pathfindNodes = GetPathfindNodesAmbush(config)

					local reIndex = 1
					while reIndex <= #pathfindNodes and entity:IsAlive() do
						if model:GetAttribute("IsChasing") then break end
						local v = pathfindNodes[reIndex]
						if v and v.Parent then
							local cframe = v.CFrame + Vector3.new(0, 3 + config.Entity.HeightOffset, 0)
							EntityMoveTo(model, cframe, config)
							task.spawn(entity.RunCallback, entity, "OnReachNode", v)
						end
						reIndex = reIndex + 1
					end

					task.spawn(entity.RunCallback, entity, "OnRebounding", false)

					if i < reboundsCount then
						task.wait(config.Rebounding.Delay)
					end
				end
			end

			if roomAddedConn then
				roomAddedConn:Disconnect()
			end

		elseif reboundType == "BLITZ" then
			local nodesToCurrent, _ = GetPathfindNodesBlitz(config)

			if config.Movement and config.Movement.IsMoveWhenWHere then
				local multiTarget = GetMultiModelTarget()
				if multiTarget then
					model:PivotTo(multiTarget.CFrame + Vector3.new(0, config.Entity.HeightOffset, 0))
					nodesToCurrent = FilterNodesFromNearest(nodesToCurrent, multiTarget.Position)
				else
					nodesToCurrent = FilterNodesFromNearest(nodesToCurrent, model:GetPivot().Position)
				end
			end

			for _, n in next, nodesToCurrent do
				if model:GetAttribute("IsChasing") then break end
				if n and n.Parent then
					local cframe = n.CFrame + Vector3.new(0, 3 + config.Entity.HeightOffset, 0)
					EntityMoveTo(model, cframe, config)
					task.spawn(entity.RunCallback, entity, "OnReachNode", n)
				end
			end

			if config.Rebounding.Enabled and not model:GetAttribute("IsChasing") then
				local currentRoom = GetCurrentRoom(false)
				if currentRoom then
					local roomNodes = GetNodesFromRoom(currentRoom, config.Movement.Reversed, config)
					if #roomNodes > 1 then
						local randomNode = config.Movement.Reversed == false 
							and roomNodes[math.random(1, #roomNodes - 1)] 
							or roomNodes[math.random(2, #roomNodes)]

						if randomNode then
							for _ = 1, math.random(config.Rebounding.Min, config.Rebounding.Max) do
								if model:GetAttribute("IsChasing") then break end
								model:SetAttribute("Damage", true)
								task.spawn(entity.RunCallback, entity, "OnRebounding", true)

								local nodeIndex = tonumber(randomNode.Name) or 1
								for i = #roomNodes, nodeIndex, -1 do
									if model:GetAttribute("IsChasing") then break end
									local targetNode = roomNodes[math.clamp(i, 1, #roomNodes)]
									if targetNode and targetNode.Parent then
										local cframe = targetNode.CFrame + Vector3.new(0, 3 + config.Entity.HeightOffset, 0)
										EntityMoveTo(model, cframe, config)
										task.spawn(entity.RunCallback, entity, "OnReachNode", targetNode)
									end
								end

								task.wait(config.Rebounding.Delay)
								model:SetAttribute("Damage", true)
								task.spawn(entity.RunCallback, entity, "OnRebounding", false)

								for i = nodeIndex, #roomNodes do
									if model:GetAttribute("IsChasing") then break end
									local targetNode = roomNodes[math.clamp(i, 1, #roomNodes)]
									if targetNode and targetNode.Parent then
										local cframe = targetNode.CFrame + Vector3.new(0, 3 + config.Entity.HeightOffset, 0)
										EntityMoveTo(model, cframe, config)
										task.spawn(entity.RunCallback, entity, "OnReachNode", targetNode)
									end
								end
							end
						end
					end
				end
			end

			if not model:GetAttribute("IsChasing") then
				local _, updatedToEnd = GetPathfindNodesBlitz(config)
				for _, n in next, updatedToEnd do
					if model:GetAttribute("IsChasing") then break end
					if n and n.Parent then
						local cframe = n.CFrame + Vector3.new(0, 3 + config.Entity.HeightOffset, 0)
						EntityMoveTo(model, cframe, config)
						task.spawn(entity.RunCallback, entity, "OnReachNode", n)
					end
				end
			end
		end

		if model:GetAttribute("IsChasing") then
			repeat task.wait(0.2) until not entity:IsAlive()
		end

		-- Xử lý Fakeout hoàn chỉnh (Fix kẹt và khôi phục vị trí)
		if isFakeout then
			model:SetAttribute("Damage", false)

			local originalPivot = model:GetPivot()
			local downCFrame = originalPivot - Vector3.new(0, 300, 0)

			-- Tween 5s xuống -300 Y
			EntityMoveToTween(model, downCFrame, 5)

			-- Phát EndSound
			if fakeoutConfig.EndSound and fakeoutConfig.EndSound ~= "" and fakeoutConfig.EndSound ~= "rbxassetid://" and fakeoutConfig.EndSound ~= "rbxassetid://0" then
				local sound = Instance.new("Sound")
				sound.SoundId = fakeoutConfig.EndSound
				sound.Volume = 1
				sound.Parent = workspace
				sound:Play()
				Debris:AddItem(sound, 5)
			end

			task.spawn(entity.RunCallback, entity, "OnFakeoutEnd")

			local endDelay = fakeoutConfig.EndDelay or 1
			task.wait(endDelay)

			-- Tween trở lại vị trí cũ
			EntityMoveToTween(model, originalPivot, 1)

			-- Khôi phục trạng thái di chuyển bình thường
			model:SetAttribute("IsFakeout", false)
			model:SetAttribute("FakeoutFinished", true)
			model:SetAttribute("Damage", true)

			config.Movement.Fakeout.Enabled = false
			config.Movement.Speed = config.Movement.Speed * (fakeoutConfig.SpeedMultiplier or 2)
			if config.Movement.SpeedFast then
				config.Movement.SpeedFast = config.Movement.SpeedFast * (fakeoutConfig.SpeedMultiplier or 2)
			end

			-- Tiếp tục chu kỳ di chuyển bình thường cho entity này
			model:SetAttribute("Running", false)
			task.spawn(function()
				Module:Run(entity, false, isReboundRespawn)
			end)
			return
		end

		if entity:IsAlive() and not model:GetAttribute("Despawning") then
			model:SetAttribute("Despawning", true)

			if config.Movement.EndWhenEnterLatestRoom then
				task.spawn(entity.RunCallback, entity, "EndWhenGO")
				if config.Movement.EndDelay and config.Movement.EndDelay > 0 then
					task.wait(config.Movement.EndDelay)
				end
			end

			task.spawn(entity.RunCallback, entity, "OnDespawning")
			EntityMoveToSpeed(model, model:GetPivot() - Vector3.new(0, 300, 0), config.Movement.Speed or CONST.BASE_ENTITY_SPEED)
			entity:Despawn()
		end
	end)
end

if not getgenv()._internal_oghunger_entity_spawner then
	getgenv()._internal_oghunger_entity_spawner = true

	local function GetAmbient(room: Model): Color3
		return
			room:GetAttribute("AmbientOriginal") :: Color3
			or room:GetAttribute("Ambient") :: Color3
			or Color3.fromRGB(67, 51, 56)
	end

	for _, room in next, CurrentRooms:GetChildren() do
		Storage.Ambient[room] = GetAmbient(room)
	end

	CurrentRooms.ChildAdded:Connect(function(room: Model)
		Storage.Ambient[room] = GetAmbient(room)
	end)

	workspace.DescendantRemoving:Connect(function(instance: Instance)
		if instance.Name == "PathfindNodes" then
			local latestRoom = GetCurrentRoom(true)
			if latestRoom then
				instance:Clone().Parent = latestRoom
			end
		end
	end)
end

Module.Clear = function(self)
	for _, entity in next, self.ActiveEntities do
		entity:Despawn()
	end
end

Module.Unload = function(self)
	self:Clear()
	for i, v in self.Connections do
		v:Disconnect()
		self.Connections[i] = nil
	end
	for i in next, self do
		self[i] = nil
	end
end

getgenv().OgHungerNewSpawner = Module
return Module
