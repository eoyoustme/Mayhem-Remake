local function spawnEntity(entityData)
	pcall(function()
		loadstring(game:HttpGet(entityData.url))()
	end)
end

local function IsSeekActive()
	if workspace:FindFirstChild("SeekMoving") or workspace:FindFirstChild("SeekMovingNewClone") then
		return true
	end

	local currentRooms = workspace:FindFirstChild("CurrentRooms")
	if currentRooms then
		for _, room in ipairs(currentRooms:GetChildren()) do
			if room:FindFirstChild("SeekFolder") then
				return true
			end
		end
	end

	return false
end

local checkedRooms = {}

local function checkAndSpawnEntity(roomNum)
	if IsSeekActive() then return end
	if checkedRooms[roomNum] then return end
	checkedRooms[roomNum] = true

	for idx, entityData in ipairs(entityList) do
		local roomRNG = Random.new(seed + (roomNum * 1337) + (idx * 42))
		local roll = roomRNG:NextNumber(0, 100)

		if roll <= entityData.chance then
			task.spawn(function()
				local spawnDelay = roomRNG:NextNumber(5, 8)
				task.wait(spawnDelay)

				if not IsSeekActive() then
					spawnEntity(entityData)
				end
			end)
		end
	end
end

