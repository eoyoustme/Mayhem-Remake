	if lineOfSight == true then
		print("Player is looking at entity")
	else
		print("Player view is obstructed by something")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound)
	if startOfRebound == true then
		local TweenService = game:GetService("TweenService")
		print("Entity has started rebounding")

		pcall(function()
			if workspace:FindFirstChild("Threat") and workspace.Threat:FindFirstChild("Sound") then
				workspace.Threat.Sound:Play()
			end
		end)

		local colors = {
			Color3.fromRGB(255, 255, 0),   
			Color3.fromRGB(0, 0, 255),    
			Color3.fromRGB(0, 255, 0),    
			Color3.fromRGB(255, 105, 180), 
			Color3.fromRGB(255, 0, 0),     
			Color3.fromRGB(160, 32, 240)   
		}

		local randomColor = colors[math.random(1, #colors)]

		entity.Config.Movement.Speed = entity.Config.Movement.Speed * 1.3
		print("New Speed:", entity.Config.Movement.Speed)

		-- Cập nhật hiệu ứng màn hình
		local colorCorrection = game.Lighting:FindFirstChild("MainColorCorrection")
		if colorCorrection then
			colorCorrection.Contrast = 0
			colorCorrection.Saturation = 0

			local tween = TweenService:Create(colorCorrection, TweenInfo.new(0.5), {TintColor = randomColor})
			tween:Play()
		end
	else
		print("Entity has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
	print("Entity is despawning")
	local colorCorrection = game.Lighting:FindFirstChild("MainColorCorrection")
	if colorCorrection then
		colorCorrection.TintColor = Color3.fromRGB(255, 255, 255)
		colorCorrection.Contrast = 0
		colorCorrection.Saturation = 0

		local TweenService = game:GetService("TweenService")
		TweenService:Create(colorCorrection, TweenInfo.new(2.5), {Contrast = 0}):Play()
		local TW = TweenService:Create(colorCorrection, TweenInfo.new(5), {TintColor = Color3.fromRGB(255, 255, 255)})
		TW:Play()
	end
end)

entity:SetCallback("OnDespawned", function()
