	local vpCamera = Instance.new("Camera")
	vpCamera.Name = "ViewportCamera"
	vpCamera.Parent = targetViewport
	targetViewport.CurrentCamera = vpCamera

	local sceneModel = Instance.new("Model")
	sceneModel.Name = "Scene"
	sceneModel.Parent = targetViewport

	local clonedPortal = nil
	if portalTemplate then
		clonedPortal = portalTemplate:Clone()
		clonedPortal.Parent = sceneModel

		if clonedPortal:IsA("Model") then
			clonedPortal:PivotTo(portalCFrame)
		else
			local primary = clonedPortal.PrimaryPart or clonedPortal:FindFirstChildWhichIsA("BasePart", true)
			if primary then
				clonedPortal:PivotTo(portalCFrame)
			end
		end

		vpCamera.CameraSubject = sceneModel
	end

	local function updateViewportFrame()
		if not portalPart or not workspace.CurrentCamera then return end
		local cam = workspace.CurrentCamera

		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		rayParams.FilterDescendantsInstances = {Cayracto, deergod, portalPart}

		local camPos = cam.CFrame.Position
		local rayResult = workspace:Raycast(camPos, portalPart.Position - camPos, rayParams)

		if rayResult and rayResult.Instance and rayResult.Instance.CanCollide then
			targetViewport.Visible = false
			return
		end

		local baseCamCF = portalCFrame
		if clonedPortal then
			local cameraPartInModel = clonedPortal:FindFirstChild("CameraPart", true) or clonedPortal:FindFirstChild("Camera", true)
			if cameraPartInModel then
				baseCamCF = cameraPartInModel.CFrame
			end
		end

		local relativeRotation = portalCFrame.Rotation:ToObjectSpace(cam.CFrame.Rotation)
		vpCamera.CFrame = CFrame.new(baseCamCF.Position) * (baseCamCF.Rotation * relativeRotation) * CFrame.fromOrientation(0, math.pi, 0)
		vpCamera.FieldOfView = cam.FieldOfView

		local cf = portalPart.CFrame
		local halfSize = portalPart.Size / 2

		local corners = {
			cf * Vector3.new(-halfSize.X, -halfSize.Y, 0),
			cf * Vector3.new(halfSize.X, -halfSize.Y, 0),
			cf * Vector3.new(-halfSize.X, halfSize.Y, 0),
			cf * Vector3.new(halfSize.X, halfSize.Y, 0),
		}

		local minX, minY = math.huge, math.huge
		local maxX, maxY = -math.huge, -math.huge
		local visible = false

		for _, corner in ipairs(corners) do
			local screenPos = cam:WorldToViewportPoint(corner)
			if screenPos.Z > 0 then
				visible = true
				minX = math.min(minX, screenPos.X)
				minY = math.min(minY, screenPos.Y)
				maxX = math.max(maxX, screenPos.X)
				maxY = math.max(maxY, screenPos.Y)
			end
		end

		if visible and maxX > minX and maxY > minY then
			targetViewport.Visible = true
			targetViewport.Position = UDim2.fromOffset(minX, minY)
			targetViewport.Size = UDim2.fromOffset(maxX - minX, maxY - minY)
		else
			targetViewport.Visible = false
		end
	end

	local camConnection = RunService.RenderStepped:Connect(updateViewportFrame)

	for _, part in ipairs(deergod:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
	task.wait(2)
	deerGodClone.Parent = workspace

	conn:Disconnect()
	alphaVal:Destroy()

