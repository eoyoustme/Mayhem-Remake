		game.Lighting.MainColorCorrection.TintColor = Color3.fromRGB(255, 0, 0)
		TweenService:Create(game.Lighting.MainColorCorrection, TweenInfo.new(0.5), {TintColor = Color3.fromRGB(255, 255, 255)}):Play()
	end

	local teleSound = Instance.new("Sound")
