		if hum then
			hum.AutoRotate = true
			hum:ChangeState(Enum.HumanoidStateType.Running)
			hum:MoveTo(hrp.Position)
		end

		deergod:SetAttribute("CanMove", true)
		deergod:SetAttribute("State", "Chase")
	end

	if overlayGui then overlayGui:Destroy() end
	if portalPart then portalPart:Destroy() end
	if screenPortal then screenPortal:Destroy() end

	if Lord then TweenService:Create(Lord, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {PlaybackSpeed = vaule}):Play() end
	if noiseSpeedVal then TweenService:Create(noiseSpeedVal, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Value = 0.03}):Play() end
	if teleSound then teleSound:Destroy() end

	isTeleporting = false
end

task.spawn(function()
