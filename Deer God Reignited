local function followPlayer(dt)
	if isTeleporting or not Cayracto or not deergod or not deergod.PrimaryPart then return end

	local hrp = Cayracto:FindFirstChild("HumanoidRootPart") or Cayracto.PrimaryPart
	if not hrp then return end

	local currentPos = deergod.PrimaryPart.Position
	local targetPos = hrp.Position
	local distance = (targetPos - currentPos).Magnitude

	local lookTarget = Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)

	if distance > 0.5 then
		local direction = (targetPos - currentPos).Unit
		local newPos = currentPos + (direction * speed * dt)
		deergod:PivotTo(CFrame.lookAt(newPos, lookTarget))
	else
		deergod:PivotTo(CFrame.lookAt(currentPos, lookTarget))
	end
end

