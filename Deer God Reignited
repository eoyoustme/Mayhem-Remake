	local cooldown = 15

	while shuold do
		task.wait(1)
		if not shuold or isTeleporting or not deergod or not deergod.PrimaryPart or not Cayracto then continue end

		local hrp = Cayracto:FindFirstChild("HumanoidRootPart")
		if not hrp then continue end

		local dist = (deergod.PrimaryPart.Position - hrp.Position).Magnitude
		local timePassed = tick() - lastTeleportTime

		if timePassed >= cooldown then
			if dist > 300 or (timePassed >= 15 and dist > 40) then
				lastTeleportTime = tick()
				TeleportSkill()
			end
		end
	end
end)

