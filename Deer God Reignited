	local portalCFrame = CFrame.lookAt(hitPos + (hitNormal * 0.1), hitPos + (hitNormal * 2))
	local moveDir = portalCFrame.LookVector
	local startPos = portalCFrame.Position - (moveDir * 6) 
	local targetPos = portalCFrame.Position + (moveDir * 4)

	if deergod.PrimaryPart then deergod.PrimaryPart.Anchored = true end

	local alphaVal = Instance.new("NumberValue")
	alphaVal.Value = 0

	local conn = alphaVal.Changed:Connect(function(alpha)
		if deergod and deergod.Parent then
			local currentPos = startPos:Lerp(targetPos, alpha)
			deergod:PivotTo(CFrame.lookAt(currentPos, currentPos + moveDir))
		end
	end)

	local tweenMove = TweenService:Create(alphaVal, TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {Value = 1})
	tweenMove:Play()

	if isTeleporting or not deergod or not deergod.PrimaryPart or not Cayracto then return end

	local hrp = Cayracto:FindFirstChild("HumanoidRootPart") or Cayracto.PrimaryPart
	if not hrp then return end

	isTeleporting = true

	if Lord then
		TweenService:Create(Lord, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {PlaybackSpeed = 0.45}):Play()
	end
	if noiseSpeedVal then
		TweenService:Create(noiseSpeedVal, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Value = 0.1}):Play()
	end

	local CameraShaker = require(ReplicatedStorage:WaitForChild("CameraShaker"))
