local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local human = character:FindFirstChild("HumanoidRootPart")

local StalkerModel = "https://github.com/eoyoustme/Mayhem-Remake/raw/main/Stalker.rbxm"

function getgithubmodeL(url)
	if not (writefile and getcustomasset and request) then return nil end
	local fileName = string.match(url, "([^/]+)$") or "temp_model.rbxm"
	local response = request({Url = url, Method = "GET"})
	if response.StatusCode ~= 200 then return nil end
	writefile(fileName, response.Body)
	local assetId = getcustomasset(fileName)
	local success, result = pcall(function() return game:GetObjects(assetId)[1] end)
	return success and result or nil
end

local function spawnShocker()
	local shockerModel = getgithubmodeL(StalkerModel)
	local camera = Workspace.CurrentCamera

	local rootPart = shockerModel:FindFirstChild("HumanoidRootPart") or shockerModel:FindFirstChildWhichIsA("Part")
	shockerModel.PrimaryPart = rootPart
	shockerModel:SetPrimaryPartCFrame(camera.CFrame * CFrame.new(0, -2, -10))
	shockerModel.Parent = Workspace

	local oogaBoogaaPart = shockerModel:WaitForChild("Stalker")
	oogaBoogaaPart.Anchored = true
	oogaBoogaaPart.CanCollide = true
	local horrorScream = oogaBoogaaPart:WaitForChild("KillV2")
	local horrorScream5 = oogaBoogaaPart:WaitForChild("Kill")

	local lookDuration = 2
	local lookStart = nil
	local hasTriggered = false
	local hasFallen = false

	local function fallToGround()
		if hasFallen then return end
		hasFallen = true

		oogaBoogaaPart.Anchored = false
		oogaBoogaaPart.CanCollide = false

		task.delay(1.2, function()
			if shockerModel then
				shockerModel:Destroy()
			end
		end)
	end

	local connection
	connection = game:GetService("RunService").RenderStepped:Connect(function()
		if not character or not character:FindFirstChild("HumanoidRootPart") then return end
		if hasTriggered then connection:Disconnect() return end

		local directionToShocker = (oogaBoogaaPart.Position - camera.CFrame.Position).Unit
		local playerLookVector = camera.CFrame.LookVector
		local dot = directionToShocker:Dot(playerLookVector)

		if dot > 0.85 then
			-- Đang nhìn
			if not lookStart then
				lookStart = tick()
			elseif tick() - lookStart >= lookDuration then
				hasTriggered = true
				connection:Disconnect()

				-- Tween lao tới player
				local targetPos = character.HumanoidRootPart.Position + Vector3.new(0, -2, -2)
				local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
				local tween = TweenService:Create(oogaBoogaaPart, tweenInfo, {Position = targetPos})
				tween:Play()

				tween.Completed:Connect(function()
					task.spawn(function()
						if humanoid.Health <= 10 then
							horrorScream:Play()
							horrorScream5:Play()
							oogaBoogaaPart.Footsteps:Stop()
							oogaBoogaaPart.PlaySound:Stop()
							human.Anchored = true
							tween:Destroy()
							local Reboundcolor = Instance.new("ColorCorrectionEffect",game.Lighting)
							Reboundcolor.Name = "Warn"
							Reboundcolor.TintColor = Color3.fromRGB(255, 255, 255)
							game.TweenService:Create(Reboundcolor,TweenInfo.new(0),{TintColor = Color3.fromRGB(255, 255, 255),Saturation = 15, Contrast = 15}):Play()
							ReplicatedStorage.GameStats["Player_".. player.Name].Total.DeathCause.Value = "Stalker"
							firesignal(ReplicatedStorage.RemotesFolder.DeathHint.OnClientEvent, {
								"You died to who you call Shocker...",
								"Don't look at it or it stuns you!"
							}, "Blue")
							wait(5)
							humanoid.Health = 0
						end

						local damage = 30
						local currentHealth = humanoid.Health

						if currentHealth > 1 then
							oogaBoogaaPart.KillV23:Play()
							local newHealth = math.max(1, currentHealth - damage)
							local FLASH_COLOR = Color3.fromRGB(85, 170, 255) 
							local FLASH_DURATION = 0.05 
							local FLASH_REPEAT =  7

							local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
							local screenGui = Instance.new("ScreenGui")
							screenGui.Name = "FlashOverlay"
							screenGui.IgnoreGuiInset = true
							screenGui.Parent = playerGui

							local frame = Instance.new("Frame")
							frame.Size = UDim2.new(1, 0, 1, 0)
							frame.BackgroundColor3 = FLASH_COLOR
							frame.BackgroundTransparency = 1
							frame.BorderSizePixel = 0
							frame.Parent = screenGui

							local rebound = Instance.new("ImageLabel")
							rebound.Image = "rbxassetid://12739025060"
							rebound.Size = UDim2.new(0, 100, 0, 100)
							rebound.Position = UDim2.new(0.5, 0, 0.5, 0)
							rebound.AnchorPoint = Vector2.new(0.5, 0.5)
							rebound.Parent = screenGui
							rebound.BackgroundTransparency = 1
							rebound.ResampleMode = Enum.ResamplerMode.Pixelated
							rebound.ImageTransparency = 0
							rebound.ZIndex = 1000
							game.TweenService:Create(rebound, TweenInfo.new(1.2), {Size = UDim2.new(0, 2000, 0, 2000), ImageTransparency = 0}):Play()
							game.Debris:AddItem(rebound)

							for i = 1, FLASH_REPEAT do
								frame.BackgroundTransparency = 0 -- Flash on
								task.wait(FLASH_DURATION)
								frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
								frame.BackgroundTransparency = 0 -- Flash off
								task.wait(FLASH_DURATION)
								frame.BackgroundColor3 = Color3.fromRGB(85, 255, 255)
							end

							screenGui:Destroy()
							humanoid.Health = newHealth
						end
					end)
				end)
				wait(5)
			connection:Disconnect()
			fallToGround()
	end
		end
		end)

	-- Dự phòng
	task.delay(5, function()
		if not hasTriggered and not hasFallen then
			fallToGround()
		end
	end)

	-- Achievement
	local achievementGiver = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"))()
	achievementGiver({
		Title = "Shocking Glitch",
		Desc = "Look at me.",
		Reason = "Encounter Stalker.",
		Image = "rbxassetid://0"
	})
end

spawnShocker()
